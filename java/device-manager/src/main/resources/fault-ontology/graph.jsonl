{"op":"create","entity":{"id":"sol_check_power","type":"Solution","properties":{"name":"检查并恢复供电","estimatedTime":"15分钟","requiredTools":"万用表,绝缘手套","urgency":"HIGH","steps":"1.断开设备电源；2.用万用表测量电源输入电压，核对是否在额定范围内；3.检查电源线连接是否牢固；4.检查断路器和保险丝状态；5.更换损坏的保险丝或处理线路问题；6.重新上电，观察设备启动情况"},"created":"2024-01-01T00:00:00Z","updated":"2024-01-01T00:00:00Z"}}
{"op":"create","entity":{"id":"sol_clean_cooling","type":"Solution","properties":{"name":"清洁散热系统","estimatedTime":"30分钟","requiredTools":"压缩空气罐,毛刷,螺丝刀","urgency":"MEDIUM","steps":"1.断电并等待设备冷却至室温；2.拆开设备外壳；3.用压缩空气清洁散热风扇和散热片上的灰尘；4.检查风扇轴承，轻推风扇叶片确认转动灵活；5.如风扇损坏则更换同型号风扇；6.重新组装，上电测试温度"},"created":"2024-01-01T00:00:00Z","updated":"2024-01-01T00:00:00Z"}}
{"op":"create","entity":{"id":"sol_check_comm_cable","type":"Solution","properties":{"name":"检查通信线缆和连接","estimatedTime":"20分钟","requiredTools":"万用表,网线测试仪","urgency":"MEDIUM","steps":"1.目视检查所有通信线缆外观，查找破损或折弯；2.用万用表检查各线缆导通性；3.重新插拔连接器，确保接触良好；4.更换有故障的线缆；5.重新测试通信连接"},"created":"2024-01-01T00:00:00Z","updated":"2024-01-01T00:00:00Z"}}
{"op":"create","entity":{"id":"sol_align_comm_params","type":"Solution","properties":{"name":"校对通信参数配置","estimatedTime":"15分钟","requiredTools":"配置软件","urgency":"LOW","steps":"1.查阅设备通信协议手册；2.记录通信双方当前配置（波特率/校验位/数据位/停止位/设备地址）；3.对比两端配置，找出不一致项；4.统一修改配置参数；5.保存配置并重启，重新测试通信"},"created":"2024-01-01T00:00:00Z","updated":"2024-01-01T00:00:00Z"}}
{"op":"create","entity":{"id":"sol_calibrate_sensor","type":"Solution","properties":{"name":"校准传感器","estimatedTime":"60分钟","requiredTools":"标准仪表,校准工具包","urgency":"MEDIUM","steps":"1.准备经过计量认证的标准仪表；2.在传感器量程的0%、50%、100%三点进行对比测量；3.记录偏差值；4.通过设备配置界面执行零点和量程校准；5.再次对比确认校准后数据；6.更新校准记录"},"created":"2024-01-01T00:00:00Z","updated":"2024-01-01T00:00:00Z"}}
{"op":"create","entity":{"id":"sol_replace_sensor","type":"Solution","properties":{"name":"更换传感器","estimatedTime":"90分钟","requiredTools":"同型号备件,螺丝刀,扳手","urgency":"HIGH","steps":"1.确认备件型号与原件一致；2.停止相关工艺流程；3.断电并泄压（液体/气体介质）；4.拆除旧传感器，做好接线标记；5.安装新传感器并按标记接线；6.上电检查接线无误；7.执行初始校准；8.恢复工艺运行并监测数据"},"created":"2024-01-01T00:00:00Z","updated":"2024-01-01T00:00:00Z"}}
{"op":"create","entity":{"id":"sol_update_firmware","type":"Solution","properties":{"name":"升级固件版本","estimatedTime":"30分钟","requiredTools":"厂商固件包,配置软件","urgency":"LOW","steps":"1.在厂商官网下载最新固件版本；2.备份当前设备配置参数；3.按厂商文档进行固件升级（注意断电风险）；4.升级完成后重启设备；5.恢复配置参数；6.验证设备功能正常"},"created":"2024-01-01T00:00:00Z","updated":"2024-01-01T00:00:00Z"}}
{"op":"create","entity":{"id":"sol_reset_config","type":"Solution","properties":{"name":"恢复出厂配置重新设置","estimatedTime":"45分钟","requiredTools":"配置软件,参数手册","urgency":"MEDIUM","steps":"1.备份当前配置（即使可能有误）；2.执行设备恢复出厂设置操作；3.按工艺需求重新逐项配置参数；4.保存配置；5.测试设备功能是否恢复正常"},"created":"2024-01-01T00:00:00Z","updated":"2024-01-01T00:00:00Z"}}
{"op":"create","entity":{"id":"sol_fix_network","type":"Solution","properties":{"name":"排查网络配置问题","estimatedTime":"20分钟","requiredTools":"ping工具,IP扫描工具","urgency":"MEDIUM","steps":"1.用IP扫描工具检查网络中是否有IP冲突；2.修改冲突设备的IP地址；3.检查交换机端口指示灯状态；4.更换交换机端口或网线测试；5.检查设备网络配置（子网掩码/网关）；6.恢复网络连接后测试通信"},"created":"2024-01-01T00:00:00Z","updated":"2024-01-01T00:00:00Z"}}
{"op":"create","entity":{"id":"sol_replace_bearing","type":"Solution","properties":{"name":"更换机械轴承","estimatedTime":"120分钟","requiredTools":"专用拆装工具,同型号轴承,润滑脂","urgency":"HIGH","steps":"1.停机并锁定能源（上锁挂牌）；2.拆解相关机械部件；3.使用轴承拆装工具取出旧轴承；4.清洁轴承座；5.安装新轴承并加注适量润滑脂；6.重新组装；7.点动运行确认噪音消除；8.记录更换时间"},"created":"2024-01-01T00:00:00Z","updated":"2024-01-01T00:00:00Z"}}
{"op":"create","entity":{"id":"sol_improve_ventilation","type":"Solution","properties":{"name":"改善散热环境","estimatedTime":"60分钟","requiredTools":"温度计,通风设备","urgency":"HIGH","steps":"1.测量设备安装环境温度；2.检查设备通风间距是否符合要求（通常>100mm）；3.增加环境通风或空调降温措施；4.避免设备直接暴露在阳光下；5.安装温度监测报警装置；6.持续监测温度变化"},"created":"2024-01-01T00:00:00Z","updated":"2024-01-01T00:00:00Z"}}
