{"type":"node","id":"cp_laser_power_sw","label":"检查激光器开关状态","entity":"Checkpoint","properties":{"description":"检查激光器电源开关和使能开关是否处于开启状态","priority":1,"method":"查看激光器控制面板或软件开关状态","expectedValue":"开关处于ON状态"}}
{"type":"node","id":"cp_laser_ctrl_signal","label":"检查激光控制信号","entity":"Checkpoint","properties":{"description":"检查控制系统发送给激光器的控制信号是否正常","priority":2,"method":"查看信号配置和通信状态","expectedValue":"信号正常连通"}}
{"type":"node","id":"cp_laser_power_val","label":"检查激光功率参数","entity":"Checkpoint","properties":{"description":"检查激光功率设定值是否合理","priority":2,"method":"查看工艺参数中的功率设置","expectedValue":"功率大于等于材料所需最低切割功率"}}
{"type":"node","id":"cp_optical_align","label":"检查光路准直状态","entity":"Checkpoint","properties":{"description":"检查切割头光路是否清洁，准直是否正确","priority":2,"method":"目视检查或使用光路检测工具","expectedValue":"光路清洁无偏移"}}
{"type":"node","id":"cp_cut_speed","label":"检查切割速度参数","entity":"Checkpoint","properties":{"description":"检查切割速度是否适合当前材料和厚度","priority":1,"method":"查看工艺参数","expectedValue":"速度在材料工艺手册推荐范围内"}}
{"type":"node","id":"cp_focus_position","label":"检查焦点位置设置","entity":"Checkpoint","properties":{"description":"检查切割头焦点位置是否正确","priority":1,"method":"查看切割头焦点位置参数","expectedValue":"焦点位置符合材料工艺要求"}}
{"type":"node","id":"cp_estop_btn","label":"检查急停按钮状态","entity":"Checkpoint","properties":{"description":"检查所有急停按钮是否处于复位状态","priority":1,"method":"目视检查急停按钮，确认均已弹起复位","expectedValue":"急停按钮已复位"}}
{"type":"node","id":"cp_power_supply","label":"检查电源供应状态","entity":"Checkpoint","properties":{"description":"检查主控电源、驱动器电源是否正常","priority":1,"method":"查看电源指示灯和电压表","expectedValue":"电源电压在额定范围内"}}
{"type":"node","id":"cp_system_log","label":"检查系统日志","entity":"Checkpoint","properties":{"description":"查看系统报警日志，获取具体错误信息","priority":3,"method":"查看控制系统日志界面","expectedValue":"日志中无致命错误"}}
{"type":"node","id":"cause_io_state_error","label":"IO点位常闭常开状态错误","entity":"Cause","properties":{"description":"W轴限位IO点位的常闭/常开状态配置与实际接线不符"}}
{"type":"node","id":"cause_focus_out_range","label":"焦点参数超出调焦范围","entity":"Cause","properties":{"description":"工艺参数中焦点值设置过大，导致W轴需要移动到物理限位之外"}}
{"type":"node","id":"cause_w_mech_limit","label":"W轴到达机械限位","entity":"Cause","properties":{"description":"W轴实际运动超出了机械行程限位开关的触发位置"}}
{"type":"node","id":"cause_laser_sw_off","label":"激光器开关处于关闭状态","entity":"Cause","properties":{"description":"操作人员未开启激光器电源或使能开关"}}
{"type":"node","id":"cause_laser_signal_cfg","label":"激光控制信号配置错误","entity":"Cause","properties":{"description":"控制系统与激光器之间的通信信号配置不正确"}}
{"type":"node","id":"cause_laser_power_low","label":"激光功率设置过低","entity":"Cause","properties":{"description":"工艺参数中激光功率设定值低于切割所需功率"}}
{"type":"node","id":"cause_optical_dirty","label":"光路污染或偏移","entity":"Cause","properties":{"description":"切割头内部镜片污染或光路准直偏移"}}
{"type":"node","id":"cause_speed_too_fast","label":"切割速度过快","entity":"Cause","properties":{"description":"切割速度超过材料在该功率下的最大切割速度"}}
{"type":"node","id":"cause_focus_misset","label":"焦点位置设置不当","entity":"Cause","properties":{"description":"切割头焦点位置偏离材料表面最优切割位置"}}
{"type":"node","id":"cause_estop_active","label":"急停按钮被激活","entity":"Cause","properties":{"description":"一个或多个急停按钮处于按下锁定状态"}}
{"type":"node","id":"cause_power_module_fault","label":"电源模块故障","entity":"Cause","properties":{"description":"主控或驱动器电源模块出现故障，无法正常供电"}}
{"type":"node","id":"sol_fix_io_state","label":"修改IO点位常闭常开状态","entity":"Solution","properties":{"description":"将W正限位/W负限位点位改回常闭状态后保存","steps":"1.打开控制软件IO配置界面;2.找到W正限位和W负限位对应的IO点位;3.将点位状态从常开改为常闭;4.保存配置并重启","estimatedTime":"5分钟","effectiveness":"HIGH","riskLevel":"LOW"}}
{"type":"node","id":"sol_adjust_focus","label":"调整焦点参数","entity":"Solution","properties":{"description":"修改工艺参数中的焦点值，使其在调焦范围内","steps":"1.打开工艺参数配置;2.找到焦点参数;3.将焦点值调整到调焦范围内;4.保存并测试","estimatedTime":"10分钟","effectiveness":"HIGH","riskLevel":"LOW"}}
{"type":"node","id":"sol_move_w_manual","label":"手动回零W轴","entity":"Solution","properties":{"description":"手动控制W轴回到原点或安全位置","steps":"1.切换到手动控制模式;2.缓慢移动W轴至中间安全位置;3.执行回零操作;4.确认W轴在安全范围内","estimatedTime":"5分钟","effectiveness":"MEDIUM","riskLevel":"LOW"}}
{"type":"node","id":"sol_turn_on_laser","label":"开启激光器开关","entity":"Solution","properties":{"description":"确认并开启激光器电源开关和使能开关","steps":"1.检查激光器控制面板上的电源开关;2.确认钥匙开关处于ON位置;3.开启软件中的激光使能;4.等待激光器初始化完成","estimatedTime":"3分钟","effectiveness":"HIGH","riskLevel":"LOW"}}
{"type":"node","id":"sol_recfg_laser_signal","label":"重新配置激光控制信号","entity":"Solution","properties":{"description":"检查并修正激光器控制信号配置","steps":"1.查看激光器通信接口说明;2.对照配置文件检查信号映射;3.修正错误的信号配置;4.保存并测试激光输出","estimatedTime":"30分钟","effectiveness":"HIGH","riskLevel":"MEDIUM"}}
{"type":"node","id":"sol_increase_power","label":"提高激光功率参数","entity":"Solution","properties":{"description":"在工艺参数中提高激光功率至适合材料的数值","steps":"1.参考材料工艺手册;2.打开工艺参数配置;3.提高功率至推荐值;4.进行试切验证","estimatedTime":"15分钟","effectiveness":"HIGH","riskLevel":"LOW"}}
{"type":"node","id":"sol_clean_optical","label":"清洁并校准光路","entity":"Solution","properties":{"description":"清洁切割头镜片，重新校准光路准直","steps":"1.关闭激光器电源;2.按规范拆下切割头;3.用专用清洁工具清洁镜片;4.重新安装并校准准直;5.测试切割效果","estimatedTime":"60分钟","effectiveness":"HIGH","riskLevel":"MEDIUM"}}
{"type":"node","id":"sol_reduce_speed","label":"降低切割速度","entity":"Solution","properties":{"description":"在工艺参数中降低切割速度至合适值","steps":"1.参考材料工艺手册的速度建议;2.打开工艺参数配置;3.降低切割速度20到30%;4.进行试切验证","estimatedTime":"10分钟","effectiveness":"HIGH","riskLevel":"LOW"}}
{"type":"node","id":"sol_reset_focus_pos","label":"重新设置焦点位置","entity":"Solution","properties":{"description":"重新测量并设置切割头焦点位置","steps":"1.使用焦点测量工具;2.测量当前材料的最优焦点位置;3.在参数中更新焦点位置值;4.验证切割效果","estimatedTime":"20分钟","effectiveness":"HIGH","riskLevel":"LOW"}}
{"type":"node","id":"sol_release_estop","label":"复位急停按钮","entity":"Solution","properties":{"description":"找到并复位所有被激活的急停按钮","steps":"1.检查设备上所有急停按钮位置;2.顺时针旋转解锁急停按钮;3.在控制软件中清除急停报警;4.重新启动设备","estimatedTime":"3分钟","effectiveness":"HIGH","riskLevel":"LOW"}}
{"type":"node","id":"sol_fix_power_module","label":"检修电源模块","entity":"Solution","properties":{"description":"检查并修复或更换故障电源模块","steps":"1.断开设备总电源;2.检查电源模块指示灯和熔断器;3.更换故障熔断器或电源模块;4.上电测试","estimatedTime":"120分钟","effectiveness":"HIGH","riskLevel":"HIGH"}}
