{"type":"node","id":"cp_w_position","label":"检查W轴当前位置","entity":"Checkpoint","properties":{"description":"检查W轴当前坐标值是否在允许范围内","priority":2,"method":"查看轴状态界面","expectedValue":"在调焦范围内"}}
