{"type":"node","id":"sol_regrease_spindle","label":"补充并更换主轴润滑脂","entity":"Solution","properties":{"description":"按标准补脂并校验供脂周期","steps":"1.执行停机挂牌;2.清理旧润滑脂;3.按标准补充新脂;4.恢复后空载跑合;5.复测温升","estimatedTime":"45分钟","effectiveness":"HIGH","riskLevel":"LOW","requiredSkill":"机械点检"}}
{"type":"node","id":"sol_replace_bearing","label":"更换主轴轴承并跑合验证","entity":"Solution","properties":{"description":"更换受损轴承并完成装配与跑合验证","steps":"1.拆卸主轴组件;2.更换轴承;3.测量预紧与跳动;4.执行跑合程序;5.验证振动温升","estimatedTime":"6小时","effectiveness":"HIGH","riskLevel":"HIGH","requiredSkill":"精密装配"}}
{"type":"node","id":"sol_adjust_screw","label":"调整或更换丝杠螺母副","entity":"Solution","properties":{"description":"校正反向间隙并恢复进给轴定位精度","steps":"1.检测丝杠磨损;2.调整预紧或更换螺母副;3.重建补偿参数;4.复测定位精度","estimatedTime":"4小时","effectiveness":"HIGH","riskLevel":"MEDIUM","requiredSkill":"机械维修"}}
{"type":"node","id":"sol_calibrate_encoder","label":"校准编码器零点并复核接线","entity":"Solution","properties":{"description":"校准编码器零点并排除接线干扰","steps":"1.断电检查接线;2.校准零点;3.执行伺服自学习;4.复测跟随误差","estimatedTime":"90分钟","effectiveness":"HIGH","riskLevel":"MEDIUM","requiredSkill":"电气调试"}}
{"type":"node","id":"sol_overhaul_pump","label":"检修液压泵与密封组件","entity":"Solution","properties":{"description":"检修液压泵内泄并恢复系统保压能力","steps":"1.停机泄压;2.拆检液压泵;3.更换密封件;4.恢复油液并排气;5.验证保压","estimatedTime":"3小时","effectiveness":"HIGH","riskLevel":"MEDIUM","requiredSkill":"液压维修"}}
{"type":"node","id":"sol_replace_filter","label":"更换液压过滤器并清洗油路","entity":"Solution","properties":{"description":"更换堵塞滤芯并清洗油路恢复流量","steps":"1.停机泄压;2.更换滤芯;3.清洗油路;4.补充液压油;5.复测压差","estimatedTime":"60分钟","effectiveness":"HIGH","riskLevel":"LOW","requiredSkill":"液压点检"}}
{"type":"node","id":"sol_reset_home_switch","label":"重新校准刀库原点开关","entity":"Solution","properties":{"description":"调整原点开关位置并验证换刀原点一致性","steps":"1.调整原点开关位置;2.紧固触发片;3.执行多次回零测试;4.记录校准结果","estimatedTime":"40分钟","effectiveness":"HIGH","riskLevel":"LOW","requiredSkill":"机电维修"}}
