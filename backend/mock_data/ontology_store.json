  "functions": [
    {
      "id": 1,
      "name": "match_fault_pattern",
      "displayName": "故障模式匹配",
      "description": "根据报警码、趋势参数和诊断信号匹配最可能的故障模式及根因链路。",
      "status": "ACTIVE",
      "scriptType": "PYTHON",
      "scriptContent": "def match_fault_pattern(alarm_code, signals):\n    \"\"\"匹配故障模式并返回候选链路\"\"\"\n    patterns = graph.query(f\"MATCH (p:Phenomenon)-[:contains]->(sp:SubPhenomenon) WHERE p.code = '{alarm_code}' RETURN p, sp\")\n    return rank_by_signal_similarity(patterns, signals)"
    },
    {
      "id": 2,
      "name": "calc_maintenance_priority",
      "displayName": "维修优先级评估",
      "description": "综合设备关键等级、停机影响和安全风险计算维修优先级。",
      "status": "ACTIVE",
      "scriptType": "PYTHON",
      "scriptContent": "def calc_maintenance_priority(severity, criticality, downtime_impact):\n    weights = {\"CRITICAL\": 1.0, \"HIGH\": 0.8, \"MEDIUM\": 0.5, \"LOW\": 0.2}\n    score = weights.get(severity, 0.5) * 0.45 + criticality * 0.35 + downtime_impact * 0.20\n    return \"P1\" if score > 0.8 else \"P2\" if score > 0.55 else \"P3\""
    },
    {
      "id": 3,
      "name": "generate_checkpoint_list",
      "displayName": "生成排查清单",
      "description": "基于故障现象自动输出按优先级排序的检查点和安全确认步骤。",
      "status": "ACTIVE",
      "scriptType": "PYTHON",
      "scriptContent": "def generate_checkpoint_list(phenomenon_id):\n    checkpoints = graph.query(\n        f\"MATCH (p:Phenomenon)-[:needs_check]->(cp:Checkpoint) WHERE p.id = '{phenomenon_id}' RETURN cp ORDER BY cp.priority\"\n    )\n    return [{\"step\": i + 1, \"name\": cp.label, \"method\": cp.method, \"safety\": cp.safetyNote} for i, cp in enumerate(checkpoints)]"
    }
  ],
