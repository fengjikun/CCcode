  "functions": [
    {
      "id": 1,
      "name": "故障现象检索",
      "displayName": "故障现象检索",
      "description": "根据报警码、现象摘要和趋势快照召回候选故障现象与细分异常。",
      "status": "ACTIVE",
      "scriptType": "PYTHON",
      "scriptContent": "def retrieve_fault_symptoms(alarm_code, symptom_summary, trend_snapshot):\n    \"\"\"检索候选故障现象并输出相似度排序结果。\"\"\"\n    candidates = graph.query(\n        \"MATCH (p:Phenomenon)-[:contains]->(sp:SubPhenomenon) RETURN p, sp\"\n    )\n    return rank_candidates(candidates, alarm_code=alarm_code, summary=symptom_summary, trend=trend_snapshot)"
    },
    {
      "id": 2,
      "name": "根因链路追溯",
      "displayName": "根因链路追溯",
      "description": "沿故障现象到根因再到处置方案的链路回溯标准诊断路径。",
      "status": "ACTIVE",
      "scriptType": "PYTHON",
      "scriptContent": "def trace_root_cause_chain(sub_phenomenon_id):\n    \"\"\"返回根因、处置方案和关键验证证据。\"\"\"\n    return graph.query(\n        f\"MATCH (sp:SubPhenomenon {{id: '{sub_phenomenon_id}'}})-[:caused_by]->(c:Cause)-[:solved_by]->(s:Solution) RETURN c, s\"\n    )"
    },
    {
      "id": 3,
      "name": "排查清单生成",
      "displayName": "排查清单生成",
      "description": "基于故障现象自动输出按优先级排序的检查点、安全动作和备件建议。",
      "status": "ACTIVE",
      "scriptType": "PYTHON",
      "scriptContent": "def build_checkpoint_list(phenomenon_id):\n    checkpoints = graph.query(\n        f\"MATCH (p:Phenomenon)-[:needs_check]->(cp:Checkpoint) WHERE p.id = '{phenomenon_id}' RETURN cp ORDER BY cp.priority\"\n    )\n    return [{\"step\": i + 1, \"name\": cp.label, \"method\": cp.method, \"safety\": cp.safetyNote, \"priority\": cp.priority} for i, cp in enumerate(checkpoints)]"
    },
    {
      "id": 4,
      "name": "维修优先级评估",
      "displayName": "维修优先级评估",
      "description": "综合故障等级、设备关键性、停机影响和安全风险，输出维修优先级和评分。",
      "status": "ACTIVE",
      "scriptType": "PYTHON",
      "scriptContent": "def evaluate_maintenance_priority(severity, equipment_criticality, downtime_impact, safety_risk):\n    weights = {\"CRITICAL\": 1.0, \"HIGH\": 0.85, \"MEDIUM\": 0.6, \"LOW\": 0.3}\n    severity_score = weights.get(severity, 0.5)\n    score = severity_score * 0.4 + equipment_criticality * 0.25 + downtime_impact * 0.2 + safety_risk * 0.15\n    return {\"priority\": \"P1\" if score >= 0.8 else \"P2\" if score >= 0.6 else \"P3\", \"score\": round(score, 3)}"
    },
    {
      "id": 5,
      "name": "复机验证判定",
      "displayName": "复机验证判定",
      "description": "结合振动、温升和试切结果判断是否满足复机条件，并给出回退建议。",
      "status": "DRAFT",
      "scriptType": "PYTHON",
      "scriptContent": "def decide_recovery_readiness(vibration_rms, spindle_temp_rise, test_cut_passed):\n    passed = vibration_rms <= 2.8 and spindle_temp_rise <= 18 and test_cut_passed\n    return {\n        \"ready\": passed,\n        \"decision\": \"PASS\" if passed else \"RECHECK\",\n        \"nextAction\": \"close_work_order\" if passed else \"reopen_diagnostic_flow\"\n    }"
    }
  ],
  "idSeq": 1000
}
