# LLM 配置（可选，不填则使用本地知识图谱诊断）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 认证配置（建议在部署时显式配置）
AUTH_SECRET_KEY=replace-with-a-strong-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_PASSWORD_HASH_ITERATIONS=200000
AUTH_DEFAULT_USERNAME=admin
AUTH_DEFAULT_PASSWORD=admin123456

# ─── 数据库配置 ──────────────────────────────────────────────────────────
# DB_TYPE: sqlite（默认，零配置）或 mysql
DB_TYPE=sqlite

# 以下配置仅在 DB_TYPE=mysql 时生效
DB_HOST=cccode-mysql
DB_PORT=3306
DB_USER=cccode
DB_PASSWORD=CCcode@2024
DB_NAME=cccode

# MySQL 容器 root 密码（仅 docker-compose 启动 MySQL 时使用）
MYSQL_ROOT_PASSWORD=CCcode@root2024
MYSQL_PORT=3306
